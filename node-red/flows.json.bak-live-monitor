    "template": "<!doctype html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>୨୧ Coquette Dobot HMI ୨୧</title>\n\n    <script>\n      function toggleDarkMode() {\n        document.body.classList.toggle(\"dark-mode\");\n        const isDark = document.body.classList.contains(\"dark-mode\");\n\n        localStorage.setItem(\"temaHMI\", isDark ? \"dark\" : \"light\");\n\n        const btn = document.getElementById(\"darkModeBtn\");\n        btn.innerText = isDark ? \"☀️\" : \"🌙\";\n      }\n    </script>\n\n    <style>\n      @import url(\"https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Quicksand:wght@400;600&family=Inter:wght@400;600&display=swap\");\n\n      :root {\n        --pink-soft: #ffc0cb;\n        --pink-deep: #ff69b4;\n        --cream: #fff5f8;\n        --rose: #db7093;\n        --lace: #fff0f5;\n        --text-main: #db7093;\n        --card-bg: #ffffff;\n\n        --eng-bg: #f8fafc;\n        --eng-card: #ffffff;\n        --eng-text: #334155;\n        --eng-border: #e2e8f0;\n        --eng-blue: #3b82f6;\n        --eng-danger: #ef4444;\n        --eng-grid: rgba(148, 163, 184, 0.4);\n      }\n\n      body.dark-mode.theme-coquette {\n        --pink-soft: #8a2b4f;\n        --pink-deep: #ffb6c1;\n        --cream: #1f0812;\n        --rose: #ffc0cb;\n        --lace: #3d1425;\n        --text-main: #ffc0cb;\n        --card-bg: #2d0a16;\n      }\n\n      body.dark-mode.theme-engineer {\n        --eng-bg: #0f172a;\n        --eng-card: #1e293b;\n        --eng-text: #f8fafc;\n        --eng-border: #334155;\n        --eng-blue: #3b82f6;\n        --eng-grid: rgba(255, 255, 255, 0.07);\n      }\n\n      .btn-dark-toggle {\n        position: fixed;\n        top: 20px;\n        right: 20px;\n        width: 45px;\n        height: 45px;\n        border-radius: 50%;\n        border: none;\n        font-size: 1.2em;\n        cursor: pointer;\n        z-index: 9999;\n        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);\n        transition: all 0.3s ease;\n      }\n      .theme-coquette .btn-dark-toggle {\n        background: var(--pink-soft);\n        color: white;\n      }\n      .theme-engineer .btn-dark-toggle {\n        background: var(--eng-text);\n        color: var(--eng-bg);\n      }\n      .btn-dark-toggle:active {\n        transform: scale(0.9);\n      }\n\n      body {\n        background-color: var(--cream);\n        font-family: \"Quicksand\", sans-serif;\n        color: var(--text-main);\n        margin: 0;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        min-height: 100vh;\n        background-image: radial-gradient(\n          var(--pink-soft) 2px,\n          transparent 2px\n        );\n        background-size: 25px 25px;\n        overflow-x: hidden;\n        user-select: none;\n        -webkit-user-select: none;\n        transition:\n          background-color 0.4s ease,\n          color 0.4s ease;\n      }\n\n      .page {\n        display: none;\n        width: 100%;\n        max-width: 550px;\n        padding: 20px;\n        text-align: center;\n      }\n      .page-wide {\n        max-width: 900px;\n      }\n      .active {\n        display: block;\n        animation: softFade 0.6s ease-in-out;\n      }\n      @keyframes softFade {\n        from {\n          opacity: 0;\n          transform: scale(0.95);\n        }\n        to {\n          opacity: 1;\n          transform: scale(1);\n        }\n      }\n\n      .card {\n        background: var(--card-bg);\n        border: 5px solid var(--pink-soft);\n        border-radius: 40px;\n        padding: 40px;\n        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);\n        position: relative;\n        outline: 2px dashed var(--card-bg);\n        outline-offset: -12px;\n        transition: all 0.4s ease;\n      }\n      .card::before {\n        content: \"୨୧\";\n        position: absolute;\n        top: -25px;\n        left: 50%;\n        transform: translateX(-50%);\n        font-size: 3em;\n        filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.1));\n      }\n      h1 {\n        font-family: \"Caveat\", cursive;\n        font-size: 3.5em;\n        color: var(--pink-deep);\n        margin-bottom: 5px;\n      }\n      p {\n        font-style: italic;\n        font-size: 0.95em;\n      }\n\n      .input-group {\n        margin: 20px 0;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        gap: 10px;\n      }\n      .input-wrapper {\n        position: relative;\n        width: 85%;\n      }\n      input {\n        width: 100%;\n        box-sizing: border-box;\n        padding: 15px;\n        border: 2px solid var(--pink-soft);\n        border-radius: 20px;\n        outline: none;\n        text-align: center;\n        font-family: \"Quicksand\", sans-serif;\n        background: var(--lace);\n        color: var(--text-main);\n        transition: 0.3s;\n      }\n      input:focus {\n        border-color: var(--pink-deep);\n        background: var(--card-bg);\n      }\n      .toggle-eye {\n        position: absolute;\n        right: 15px;\n        top: 50%;\n        transform: translateY(-50%);\n        cursor: pointer;\n        font-size: 1em;\n        font-weight: bold;\n        opacity: 0.7;\n      }\n      .toggle-eye:hover {\n        opacity: 1;\n      }\n\n      .coord-container {\n        background: var(--lace);\n        border: 2px dashed var(--pink-soft);\n        border-radius: 20px;\n        padding: 15px;\n        margin: 20px 0;\n      }\n      .coord-display {\n        font-size: 1.1em;\n        font-weight: bold;\n        color: var(--pink-deep);\n        margin-bottom: 15px;\n      }\n      .coord-inputs {\n        display: flex;\n        gap: 8px;\n        justify-content: center;\n      }\n      .coord-inputs input {\n        width: 60px;\n        padding: 10px;\n        font-size: 0.9em;\n        border-radius: 10px;\n      }\n\n      .btn {\n        background-color: var(--pink-soft);\n        color: white;\n        border: none;\n        padding: 15px 35px;\n        border-radius: 30px;\n        font-size: 1.1em;\n        font-weight: 600;\n        cursor: pointer;\n        transition: all 0.3s ease;\n        margin: 10px;\n        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\n      }\n      .btn:hover {\n        background-color: var(--pink-deep);\n        transform: translateY(-3px);\n      }\n      .btn:active {\n        transform: scale(0.95);\n      }\n      .btn-sm {\n        padding: 10px 20px;\n        font-size: 0.9em;\n      }\n      .btn-back {\n        background-color: #cbd5e1;\n        color: #334155;\n      }\n      .btn-danger {\n        background-color: #ff9999;\n        color: white;\n        margin-top: 15px;\n        width: 100%;\n      }\n\n      .menu-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 18px;\n        margin-top: 25px;\n      }\n      .menu-box {\n        background: var(--lace);\n        border: 2px solid var(--pink-soft);\n        padding: 25px;\n        border-radius: 25px;\n        cursor: pointer;\n        transition: 0.3s;\n        font-weight: bold;\n        font-size: 1.2em;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 10px;\n        color: var(--text-main);\n      }\n      .menu-box:hover {\n        background: var(--card-bg);\n        border-color: var(--pink-deep);\n        transform: scale(1.02);\n      }\n\n      .analog-wrapper {\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        gap: 30px;\n        margin: 20px auto;\n        padding: 25px;\n        background: var(--lace);\n        border-radius: 40px;\n        width: max-content;\n      }\n      .analog-container {\n        display: grid;\n        grid-template-columns: 55px 55px 55px;\n        grid-template-rows: 55px 55px 55px;\n        gap: 8px;\n        justify-items: center;\n        align-items: center;\n      }\n      .btn-ctrl {\n        width: 50px;\n        height: 50px;\n        padding: 0;\n        border-radius: 50%;\n        font-size: 1.3em;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        background: var(--card-bg);\n        border: 2px solid var(--pink-soft);\n        color: var(--text-main);\n        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.05);\n        cursor: pointer;\n        touch-action: manipulation;\n        transition: 0.3s;\n      }\n      .btn-ctrl:active {\n        transform: scale(0.9);\n        background: var(--pink-deep);\n        color: white;\n      }\n\n      .modal-overlay {\n        display: none;\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background: rgba(0, 0, 0, 0.6);\n        backdrop-filter: blur(4px);\n        z-index: 2000;\n        justify-content: center;\n        align-items: center;\n      }\n      .modal-box {\n        background: var(--card-bg);\n        border: 4px dashed var(--pink-soft);\n        border-radius: 30px;\n        padding: 30px 40px;\n        text-align: center;\n        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);\n        max-width: 80%;\n        width: 350px;\n        animation: popIn 0.5s ease;\n        color: var(--text-main);\n      }\n      .modal-box h2 {\n        font-family: \"Caveat\", cursive;\n        font-size: 3em;\n        color: var(--pink-deep);\n        margin: 0 0 10px 0;\n      }\n\n      body.theme-engineer {\n        background-color: var(--eng-bg);\n        background-image: none;\n        font-family: \"Inter\", sans-serif;\n        color: var(--eng-text);\n      }\n      body.theme-engineer .card {\n        background: var(--eng-card);\n        border: 1px solid var(--eng-border);\n        border-radius: 12px;\n        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);\n        outline: none;\n      }\n      body.theme-engineer .card::before {\n        content: none;\n      }\n      body.theme-engineer h1 {\n        font-family: \"Inter\", sans-serif;\n        font-weight: 600;\n        font-size: 2.2em;\n        color: var(--eng-text);\n      }\n      body.theme-engineer p {\n        font-style: normal;\n      }\n      body.theme-engineer .btn {\n        background-color: var(--eng-blue);\n        border-radius: 6px;\n        box-shadow: none;\n        font-family: \"Inter\", sans-serif;\n      }\n      body.theme-engineer .btn-back {\n        background-color: var(--eng-border);\n        color: var(--eng-text);\n      }\n      body.theme-engineer .btn-danger {\n        background-color: var(--eng-danger);\n        color: white;\n        margin-top: 0;\n        width: auto;\n        padding: 8px 15px;\n        font-size: 0.9em;\n      }\n      body.theme-engineer .menu-box {\n        background: var(--eng-bg);\n        border: 1px solid var(--eng-border);\n        border-radius: 8px;\n        font-family: \"Inter\", sans-serif;\n        color: var(--eng-text);\n      }\n\n      body.theme-engineer .modal-box {\n        border: 1px solid var(--eng-border);\n        border-radius: 12px;\n        background: var(--eng-card);\n        color: var(--eng-text);\n      }\n\n      body.theme-engineer input {\n        border: 1px solid var(--eng-border);\n        border-radius: 6px;\n        background: var(--eng-bg);\n        color: var(--eng-text);\n        font-family: \"Inter\", sans-serif;\n      }\n\n      .sim-workspace {\n        position: relative;\n        width: 100%;\n        height: 430px;\n        margin: 20px 0;\n        background: var(--eng-bg);\n        border-radius: 8px;\n        overflow: hidden;\n        border: 1px solid var(--eng-border);\n        background-image:\n          linear-gradient(to right, var(--eng-grid) 1px, transparent 1px),\n          linear-gradient(to bottom, var(--eng-grid) 1px, transparent 1px);\n        background-size: 5px 5px;\n      }\n      .sim-base {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 70%;\n        height: 100%;\n        background-color: rgba(148, 163, 184, 0.1);\n        border-right: 3px dashed var(--eng-border);\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        pointer-events: none;\n      }\n      .sim-base::after {\n        content: \"ALAS (Area Cetak 39.5 x 19.5)\";\n        position: absolute;\n        bottom: 15px;\n        left: 15px;\n        color: #94a3b8;\n        font-weight: bold;\n        letter-spacing: 1px;\n      }\n      .sim-tray {\n        position: absolute;\n        right: 0;\n        top: 0;\n        width: 30%;\n        height: 100%;\n        background-color: rgba(0, 0, 0, 0.03);\n        pointer-events: none;\n      }\n\n      .tangram-piece {\n        position: absolute;\n        cursor: grab;\n        filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.2));\n        z-index: 10;\n        transition: transform 0.15s ease;\n      }\n      .tangram-piece:active {\n        cursor: grabbing;\n        z-index: 100;\n        filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.4));\n      }\n\n      .shape-big-tri-1 {\n        width: 200px;\n        height: 100px;\n        background: #ef4444;\n        clip-path: polygon(0 100%, 50% 0, 100% 100%);\n      }\n      .shape-big-tri-2 {\n        width: 200px;\n        height: 100px;\n        background: #ec4899;\n        clip-path: polygon(0 100%, 50% 0, 100% 100%);\n      }\n      .shape-med-tri {\n        width: 100px;\n        height: 100px;\n        background: #f97316;\n        clip-path: polygon(0 0, 0 100%, 100% 100%);\n      }\n      .shape-small-tri-1 {\n        width: 100px;\n        height: 50px;\n        background: #22c55e;\n        clip-path: polygon(0 100%, 50% 0, 100% 100%);\n      }\n      .shape-small-tri-2 {\n        width: 100px;\n        height: 50px;\n        background: #14b8a6;\n        clip-path: polygon(0 100%, 50% 0, 100% 100%);\n      }\n      .shape-square {\n        width: 50px;\n        height: 50px;\n        background: #3b82f6;\n      }\n      .shape-para {\n        width: 100px;\n        height: 50px;\n        background: #a855f7;\n        clip-path: polygon(50px 0, 100px 0, 50px 100%, 0 100%);\n      }\n\n      .delete-list-item {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 10px;\n        border-bottom: 1px solid var(--eng-border);\n        font-size: 1.1em;\n        color: var(--eng-text);\n      }\n    </style>\n  </head>\n  <body class=\"theme-coquette\">\n    <button class=\"btn-dark-toggle\" id=\"darkModeBtn\" onclick=\"toggleDarkMode()\">\n      🌙\n    </button>\n\n    <div id=\"cuteModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 id=\"modalTitle\">(╥﹏╥)</h2>\n        <p\n          id=\"modalMessage\"\n          style=\"font-size: 1.1em; font-weight: 600; margin-bottom: 20px\"\n        >\n          Pesan error di sini\n        </p>\n        <button class=\"btn\" onclick=\"closeModal('cuteModal')\">Okee ♡</button>\n      </div>\n    </div>\n\n    <div id=\"gameModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 id=\"gameTitle\">Tebak Bentuk!</h2>\n        <p\n          id=\"gameHint\"\n          style=\"\n            color: gray;\n            font-size: 0.9em;\n            margin-bottom: 15px;\n            min-height: 20px;\n          \"\n        ></p>\n        <input\n          type=\"text\"\n          id=\"gameInput\"\n          placeholder=\"Ketik jawabanmu...\"\n          autocomplete=\"off\"\n        />\n        <button\n          class=\"btn\"\n          style=\"width: 100%; margin-top: 15px\"\n          onclick=\"submitGameGuess()\"\n        >\n          Tebak ✦\n        </button>\n      </div>\n    </div>\n\n    <div id=\"engineerNamingModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2\n          style=\"\n            font-family: &quot;Inter&quot;;\n            font-size: 1.5em;\n            color: var(--eng-text);\n            margin-bottom: 5px;\n          \"\n        >\n          Simpan Template Baru\n        </h2>\n        <p style=\"margin-bottom: 15px; font-size: 14px\">\n          Masukkan rincian bentuk dari kepingan yang ada di dalam alas:\n        </p>\n        <input\n          type=\"text\"\n          id=\"simShapeName\"\n          placeholder=\"Nama Bentuk (Wajib)\"\n          autocomplete=\"off\"\n          style=\"margin-bottom: 8px\"\n        />\n        <input\n          type=\"text\"\n          id=\"simShapeHint\"\n          placeholder=\"Petunjuk / Hint (Wajib)\"\n          autocomplete=\"off\"\n        />\n        <button\n          class=\"btn\"\n          style=\"width: 100%; margin-top: 15px\"\n          onclick=\"finalizeSimulation()\"\n        >\n          Simpan & Tambahkan\n        </button>\n        <button\n          class=\"btn btn-back\"\n          style=\"width: 100%; margin-top: 5px\"\n          onclick=\"closeModal('engineerNamingModal')\"\n        >\n          Batal\n        </button>\n      </div>\n    </div>\n\n    <div id=\"engineerDeleteModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\" style=\"width: 450px\">\n        <h2 style=\"font-family: &quot;Inter&quot;; font-size: 1.5em\">\n          Kurangi Template\n        </h2>\n        <div\n          id=\"deleteListContainer\"\n          style=\"\n            max-height: 250px;\n            overflow-y: auto;\n            text-align: left;\n            margin: 15px 0;\n          \"\n        ></div>\n        <button\n          class=\"btn btn-back\"\n          style=\"width: 100%\"\n          onclick=\"closeModal('engineerDeleteModal')\"\n        >\n          Tutup\n        </button>\n      </div>\n    </div>\n\n    <div id=\"loadingModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 id=\"loadingIcon\" style=\"font-size: 4em; margin: 0\">⚙️</h2>\n        <p id=\"loadingText\" style=\"font-weight: bold; margin-top: 15px\">\n          Dobot sedang memuat...\n        </p>\n      </div>\n    </div>\n\n    <div id=\"loginPage\" class=\"page active\">\n      <div class=\"card\">\n        <h1>Bonjouuuur! ✧</h1>\n        <p>Ready to build something cute? ✦</p>\n        <div class=\"input-group\">\n          <div class=\"input-wrapper\">\n            <input type=\"text\" placeholder=\"Username\" id=\"userInput\" />\n          </div>\n          <div class=\"input-wrapper\">\n            <input type=\"password\" placeholder=\"Password\" id=\"passInput\" />\n            <span class=\"toggle-eye\" id=\"eyeIcon\" onclick=\"togglePassword()\"\n              >O_O</span\n            >\n          </div>\n        </div>\n        <button class=\"btn\" onclick=\"validateDualLogin()\">Enter ✦</button>\n      </div>\n    </div>\n\n    <div id=\"choicePage\" class=\"page\">\n      <div class=\"card\">\n        <h2>Pilih Mode ✦</h2>\n        <div class=\"menu-grid\">\n          <div class=\"menu-box\" onclick=\"showPage('manualPage')\">\n            ✜ <span>Manual Control</span>\n          </div>\n          <div class=\"menu-box\" onclick=\"showPage('templatePage')\">\n            ❖ <span>Tangram Template</span>\n          </div>\n          <div class=\"menu-box\" onclick=\"showPage('gamePage')\">\n            🎮 <span>Game Mode</span>\n          </div>\n          <div class=\"menu-box\" style=\"border-style: dotted\" onclick=\"logout()\">\n            ⍈ <span>Sign Out</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"templatePage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Templates</h1>\n        <p>Pilih desain template ✦</p>\n        <div class=\"menu-grid\" id=\"templateGridContainer\"></div>\n        <div\n          style=\"\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n            margin-top: 20px;\n          \"\n        >\n          <button\n            class=\"btn\"\n            style=\"\n              background-color: var(--pink-soft);\n              color: white;\n              width: 100%;\n              margin: 0;\n            \"\n            onclick=\"acakFisikDobot()\"\n          >\n            ↻ Acak Kepingan Fisik\n          </button>\n          <button\n            class=\"btn btn-back\"\n            style=\"width: 100%; margin: 0\"\n            onclick=\"showPage('choicePage')\"\n          >\n            Kembali\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"gamePage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Tebak Gambar 🎀</h1>\n        <p>Pilih kotak misteri dan tebak apa yang digambar Dobot!</p>\n        <div class=\"menu-grid\" id=\"gameGridContainer\"></div>\n        <div\n          style=\"\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n            margin-top: 20px;\n          \"\n        >\n          <button\n            class=\"btn\"\n            style=\"\n              background-color: var(--pink-deep);\n              color: white;\n              width: 100%;\n              margin: 0;\n            \"\n            onclick=\"acakFisikDobot()\"\n          >\n            ↺ Acak Kepingan Fisik\n          </button>\n          <button\n            class=\"btn btn-back\"\n            style=\"width: 100%; margin: 0\"\n            onclick=\"showPage('choicePage')\"\n          >\n            Kembali\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"manualPage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Manual View ♛</h1>\n        <div class=\"coord-container\">\n          <div class=\"coord-display\">\n            📍 Saat ini: X:<span id=\"currX\">0.0</span> Y:<span id=\"currY\"\n              >0.0</span\n            >\n            Z:<span id=\"currZ\">0.0</span> R:<span id=\"currR\">0.0</span>\n          </div>\n          <div class=\"coord-inputs\">\n            <input type=\"number\" id=\"inpX\" placeholder=\"X\" />\n            <input type=\"number\" id=\"inpY\" placeholder=\"Y\" />\n            <input type=\"number\" id=\"inpZ\" placeholder=\"Z\" />\n            <input type=\"number\" id=\"inpR\" placeholder=\"R\" />\n          </div>\n          <button\n            class=\"btn btn-sm\"\n            style=\"margin-top: 10px\"\n            onclick=\"sendCoordinate()\"\n          >\n            Jalan 🚀\n          </button>\n        </div>\n\n        <div class=\"analog-wrapper\">\n          <div style=\"position: relative; margin: 10px\">\n            <span\n              style=\"\n                position: absolute;\n                top: -20px;\n                left: 50%;\n                transform: translateX(-50%);\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 0.9em;\n              \"\n              >-X</span\n            >\n            <span\n              style=\"\n                position: absolute;\n                bottom: -20px;\n                left: 50%;\n                transform: translateX(-50%);\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 0.9em;\n              \"\n              >+X</span\n            >\n            <span\n              style=\"\n                position: absolute;\n                left: -25px;\n                top: 50%;\n                transform: translateY(-50%);\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 0.9em;\n              \"\n              >-Y</span\n            >\n            <span\n              style=\"\n                position: absolute;\n                right: -25px;\n                top: 50%;\n                transform: translateY(-50%);\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 0.9em;\n              \"\n              >+Y</span\n            >\n            <div class=\"analog-container\">\n              <div></div>\n              <button\n                class=\"btn btn-ctrl\"\n                onmousedown=\"startHold('mundur')\"\n                onmouseup=\"stopHold()\"\n                onmouseleave=\"stopHold()\"\n              >\n                ▲\n              </button>\n              <div></div>\n              <button\n                class=\"btn btn-ctrl\"\n                onmousedown=\"startHold('kanan')\"\n                onmouseup=\"stopHold()\"\n                onmouseleave=\"stopHold()\"\n              >\n                ◀\n              </button>\n              <div style=\"font-size: 1.8em\">✿</div>\n              <button\n                class=\"btn btn-ctrl\"\n                onmousedown=\"startHold('kiri')\"\n                onmouseup=\"stopHold()\"\n                onmouseleave=\"stopHold()\"\n              >\n                ▶\n              </button>\n              <div></div>\n              <button\n                class=\"btn btn-ctrl\"\n                onmousedown=\"startHold('maju')\"\n                onmouseup=\"stopHold()\"\n                onmouseleave=\"stopHold()\"\n              >\n                ▼\n              </button>\n              <div></div>\n            </div>\n          </div>\n          <div\n            style=\"\n              display: flex;\n              flex-direction: column;\n              align-items: center;\n              gap: 10px;\n            \"\n          >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('atas')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n            >\n              ⇡\n            </button>\n            <span\n              style=\"\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 1.1em;\n              \"\n              >Z</span\n            >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('bawah')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n            >\n              ⇣\n            </button>\n          </div>\n          <div\n            style=\"\n              display: flex;\n              flex-direction: column;\n              align-items: center;\n              gap: 10px;\n            \"\n          >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('rotate_ccw')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n            >\n              ↺\n            </button>\n            <span\n              style=\"\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 1.1em;\n              \"\n              >R</span\n            >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('rotate_cw')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n            >\n              ↻\n            </button>\n          </div>\n        </div>\n\n        <div>\n          <button\n            class=\"btn\"\n            style=\"background-color: #ffdab9; color: #cd853f\"\n            onclick=\"sendManualCommand('grab')\"\n          >\n            Grab ♡\n          </button>\n          <button\n            class=\"btn\"\n            style=\"background-color: #e0ffff; color: #5f9ea0\"\n            onclick=\"sendManualCommand('release')\"\n          >\n            Release ✿\n          </button>\n        </div>\n        <button class=\"btn btn-danger\" onclick=\"sendManualCommand('reset')\">\n          Reset Posisi ↺\n        </button>\n        <button\n          class=\"btn\"\n          style=\"\n            border: 2px dashed var(--pink-deep);\n            margin-top: 10px;\n            width: 100%;\n            background: transparent;\n            color: var(--text-main);\n          \"\n          onclick=\"sendManualCommand('clear_alarm')\"\n        >\n          Reset Dobot\n        </button>\n        <button\n          class=\"btn btn-back\"\n          style=\"margin-top: 10px; width: 100%\"\n          onclick=\"showPage('choicePage')\"\n        >\n          Kembali\n        </button>\n      </div>\n    </div>\n\n    <div id=\"engineerChoicePage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Dashboard System</h1>\n        <p style=\"color: #64748b; margin-bottom: 30px\">\n          Template Management Configuration\n        </p>\n        <div style=\"display: flex; flex-direction: column; gap: 15px\">\n          <button\n            class=\"btn\"\n            style=\"width: 100%; padding: 20px; font-size: 1.1em\"\n            onclick=\"showPage('engineerSimPage')\"\n          >\n            + Tambah Bentuk Template\n          </button>\n          <button\n            class=\"btn btn-back\"\n            style=\"\n              width: 100%;\n              padding: 20px;\n              font-size: 1.1em;\n              border: 1px solid var(--eng-border);\n            \"\n            onclick=\"openDeleteModal()\"\n          >\n            - Kurangi Bentuk Template\n          </button>\n          <button\n            class=\"btn btn-danger\"\n            style=\"\n              width: 100%;\n              padding: 20px;\n              margin-top: 10px;\n              font-size: 1.1em;\n            \"\n            onclick=\"logout()\"\n          >\n            Sign Out\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"engineerSimPage\" class=\"page page-wide\">\n      <div class=\"card\" style=\"padding: 20px\">\n        <h2 style=\"margin: 0 0 5px 0\">Simulation Workspace</h2>\n        <p style=\"color: #64748b; font-size: 14px; margin-bottom: 20px\">\n          Susun kepingan di ALAS. Drag bebas (Snap 5px otomatis). Klik untuk\n          rotasi 45°.\n        </p>\n\n        <div class=\"sim-workspace\" id=\"simWorkspace\">\n          <div class=\"sim-base\" id=\"simBaseArea\"></div>\n          <div class=\"sim-tray\" id=\"simTrayArea\"></div>\n\n          <div\n            class=\"tangram-piece shape-big-tri-1\"\n            style=\"right: 20px; top: 20px\"\n            data-rot=\"0\"\n          ></div>\n          <div\n            class=\"tangram-piece shape-big-tri-2\"\n            style=\"right: 20px; top: 80px\"\n            data-rot=\"0\"\n          ></div>\n          <div\n            class=\"tangram-piece shape-med-tri\"\n            style=\"right: 20px; top: 140px\"\n            data-rot=\"0\"\n          ></div>\n          <div\n            class=\"tangram-piece shape-small-tri-1\"\n            style=\"right: 20px; top: 200px\"\n            data-rot=\"0\"\n          ></div>\n          <div\n            class=\"tangram-piece shape-small-tri-2\"\n            style=\"right: 20px; top: 260px\"\n            data-rot=\"0\"\n          ></div>\n          <div\n            class=\"tangram-piece shape-square\"\n            style=\"right: 20px; top: 320px\"\n            data-rot=\"0\"\n          ></div>\n          <div\n            class=\"tangram-piece shape-para\"\n            style=\"right: 20px; top: 380px\"\n            data-rot=\"0\"\n          ></div>\n        </div>\n\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px\">\n          <button class=\"btn\" onclick=\"openNamingModal()\">Submit Shape</button>\n          <button\n            class=\"btn btn-back\"\n            onclick=\"\n              resetSim();\n              showPage('engineerChoicePage');\n            \"\n          >\n            Batal & Kembali\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <script>\n      let defaultShapes = [\n        { name: \"Kucing\", hint: \"Hewan berbulu yang suka mengeong\" },\n        { name: \"Unta\", hint: \"Hewan pelintas gurun dengan punuk\" },\n        { name: \"Rumah\", hint: \"Tempat kita berlindung dan tinggal\" },\n        { name: \"Kotak\", hint: \"Bentuk dasar bersisi empat\" },\n      ];\n\n      let masterShapes = [];\n      let gameActiveList = [];\n      let gameState = [];\n      let activeGameIndex = -1;\n      let wrongAttempts = 0;\n\n      window.onload = () => {\n        const savedTheme = localStorage.getItem(\"temaHMI\");\n        if (savedTheme === \"dark\") {\n          document.body.classList.add(\"dark-mode\");\n          document.getElementById(\"darkModeBtn\").innerText = \"☀️\";\n        }\n\n        const memoriTemplate = localStorage.getItem(\"databaseTemplate\");\n        if (memoriTemplate) {\n          masterShapes = JSON.parse(memoriTemplate);\n        } else {\n          masterShapes = JSON.parse(JSON.stringify(defaultShapes));\n        }\n\n        updateCoordUI();\n        renderTemplates();\n        gameActiveList = JSON.parse(JSON.stringify(masterShapes));\n        gameState = Array(gameActiveList.length).fill(false);\n        renderGameGrid();\n      };\n\n      let currentX = 0.0,\n        currentY = 0.0,\n        currentZ = 0.0,\n        currentR = 0.0;\n      const JOG_STEP = 2.0;\n\n      function updateCoordUI() {\n        document.getElementById(\"currX\").innerText = currentX.toFixed(1);\n        document.getElementById(\"currY\").innerText = currentY.toFixed(1);\n        document.getElementById(\"currZ\").innerText = currentZ.toFixed(1);\n        document.getElementById(\"currR\").innerText = currentR.toFixed(1);\n      }\n\n      function togglePassword() {\n        const passInput = document.getElementById(\"passInput\");\n        const eyeIcon = document.getElementById(\"eyeIcon\");\n        if (passInput.type === \"password\") {\n          passInput.type = \"text\";\n          eyeIcon.innerText = \">_<\";\n        } else {\n          passInput.type = \"password\";\n          eyeIcon.innerText = \"O_O\";\n        }\n      }\n\n      function showModal(title, message) {\n        document.getElementById(\"modalTitle\").innerText = title;\n        document.getElementById(\"modalMessage\").innerText = message;\n        document.getElementById(\"cuteModal\").style.display = \"flex\";\n      }\n      function closeModal(modalId) {\n        document.getElementById(modalId).style.display = \"none\";\n      }\n      function showPage(pageId) {\n        document\n          .querySelectorAll(\".page\")\n          .forEach((p) => p.classList.remove(\"active\"));\n        document.getElementById(pageId).classList.add(\"active\");\n      }\n\n      function runTemplate(name) {\n        showModal(\n          \"Yay! ✦\",\n          \"Dobot sedang memproses template \" +\n            name +\n            \"... Mohon tunggu sebentar ya!\",\n        );\n        fetch(\"/perintah\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ mode: \"template\", target_bentuk: name }),\n        }).catch((e) => console.error(e));\n      }\n\n      function sendManualCommand(aksi) {\n        if (aksi === \"reset\") {\n          currentX = 0.0;\n          currentY = 0.0;\n          currentZ = 0.0;\n          currentR = 0.0;\n          updateCoordUI();\n        }\n        fetch(\"/perintah\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ mode: \"manual\", action: aksi }),\n        }).catch((e) => console.error(e));\n      }\n\n      function sendCoordinate() {\n        const x = document.getElementById(\"inpX\").value,\n          y = document.getElementById(\"inpY\").value,\n          z = document.getElementById(\"inpZ\").value,\n          r = document.getElementById(\"inpR\").value;\n        if (!x || !y || !z || !r) {\n          showModal(\"(╥﹏╥)\", \"Isi semua angka koordinatnya dulu yaa ♡\");\n          return;\n        }\n\n        currentX = parseFloat(x);\n        currentY = parseFloat(y);\n        currentZ = parseFloat(z);\n        currentR = parseFloat(r);\n        updateCoordUI();\n        fetch(\"/perintah\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({\n            mode: \"koordinat\",\n            target: { x: currentX, y: currentY, z: currentZ, r: currentR },\n          }),\n        }).catch((e) => console.error(e));\n\n        document.getElementById(\"inpX\").value = \"\";\n        document.getElementById(\"inpY\").value = \"\";\n        document.getElementById(\"inpZ\").value = \"\";\n        document.getElementById(\"inpR\").value = \"\";\n      }\n\n      let holdInterval = null;\n      function applyJogDirection(aksi) {\n        switch (aksi) {\n          case \"maju\":\n            currentX += JOG_STEP;\n            break;\n          case \"mundur\":\n            currentX -= JOG_STEP;\n            break;\n          case \"kiri\":\n            currentY += JOG_STEP;\n            break;\n          case \"kanan\":\n            currentY -= JOG_STEP;\n            break;\n          case \"atas\":\n            currentZ += JOG_STEP;\n            break;\n          case \"bawah\":\n            currentZ -= JOG_STEP;\n            break;\n          case \"rotate_cw\":\n            currentR -= JOG_STEP;\n            break;\n          case \"rotate_ccw\":\n            currentR += JOG_STEP;\n            break;\n        }\n        updateCoordUI();\n      }\n\n      function startHold(aksi) {\n        if (holdInterval) clearInterval(holdInterval);\n        sendManualCommand(aksi);\n        applyJogDirection(aksi);\n        holdInterval = setInterval(() => {\n          sendManualCommand(aksi);\n          applyJogDirection(aksi);\n        }, 200);\n      }\n      function stopHold() {\n        if (holdInterval) {\n          clearInterval(holdInterval);\n          holdInterval = null;\n          sendManualCommand(\"stop\");\n        }\n      }\n\n      function validateDual
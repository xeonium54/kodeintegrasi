  {
    "id": "416f6cdc6cbf9543",
    "type": "template",
    "z": "770382f96a497a5f",
    "name": "UI_HMI",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!doctype html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>୨୧ Coquette Dobot HMI ୨୧</title>\n    <link rel=\"stylesheet\" href=\"/style.css\" />\n  </head>\n  <body class=\"theme-coquette\">\n\n    <button class=\"btn-dark-toggle\" id=\"darkModeBtn\" onclick=\"toggleDarkMode()\">🌙</button>\n\n    <!-- ═══════════════════════════════════════════════════════ MODALS -->\n\n    <div id=\"cuteModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 id=\"modalTitle\">(╥﹏╥)</h2>\n        <p id=\"modalMessage\" style=\"font-size:1.1em;font-weight:600;margin-bottom:20px\">Pesan error di sini</p>\n        <button class=\"btn\" onclick=\"closeModal('cuteModal')\">Okee ♡</button>\n      </div>\n    </div>\n\n    <div id=\"gameModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 id=\"gameTitle\">Tebak Bentuk!</h2>\n        <p id=\"gameHint\" style=\"color:gray;font-size:0.9em;margin-bottom:15px;min-height:20px\"></p>\n        <input type=\"text\" id=\"gameInput\" placeholder=\"Ketik jawabanmu...\" autocomplete=\"off\" />\n        <button class=\"btn\" style=\"width:100%;margin-top:15px\" onclick=\"submitGameGuess()\">Tebak ✦</button>\n      </div>\n    </div>\n\n    <div id=\"engineerNamingModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 style=\"font-family:'Inter';font-size:1.5em;color:var(--eng-text);margin-bottom:5px\">Simpan Template Baru</h2>\n        <p style=\"margin-bottom:15px;font-size:14px\">Masukkan rincian bentuk dari kepingan yang ada di dalam alas:</p>\n        <input type=\"text\" id=\"simShapeName\" placeholder=\"Nama Bentuk (Wajib)\" autocomplete=\"off\" style=\"margin-bottom:8px\" />\n        <input type=\"text\" id=\"simShapeHint\" placeholder=\"Petunjuk / Hint (Wajib)\" autocomplete=\"off\" />\n        <button class=\"btn\" style=\"width:100%;margin-top:15px\" onclick=\"finalizeSimulation()\">Simpan & Tambahkan</button>\n        <button class=\"btn btn-back\" style=\"width:100%;margin-top:5px\" onclick=\"closeModal('engineerNamingModal')\">Batal</button>\n      </div>\n    </div>\n\n    <div id=\"engineerDeleteModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\" style=\"width:450px\">\n        <h2 style=\"font-family:'Inter';font-size:1.5em\">Kurangi Template</h2>\n        <div id=\"deleteListContainer\" style=\"max-height:250px;overflow-y:auto;text-align:left;margin:15px 0\"></div>\n        <button class=\"btn btn-back\" style=\"width:100%\" onclick=\"closeModal('engineerDeleteModal')\">Tutup</button>\n      </div>\n    </div>\n\n    <div id=\"loadingModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 id=\"loadingIcon\" style=\"font-size:4em;margin:0\">⚙️</h2>\n        <p id=\"loadingText\" style=\"font-weight:bold;margin-top:15px\">Dobot sedang memuat...</p>\n      </div>\n    </div>\n\n    <!-- ═══════════════════════════════════════════════════════ PAGES -->\n\n    <div id=\"loginPage\" class=\"page active\">\n      <div class=\"card\">\n        <h1>Bonjouuuur! ✧</h1>\n        <p>Ready to build something cute? ✦</p>\n        <div class=\"input-group\">\n          <div class=\"input-wrapper\">\n            <input type=\"text\" placeholder=\"Username\" id=\"userInput\" />\n          </div>\n          <div class=\"input-wrapper\">\n            <input type=\"password\" placeholder=\"Password\" id=\"passInput\" />\n            <span class=\"toggle-eye\" id=\"eyeIcon\" onclick=\"togglePassword()\">O_O</span>\n          </div>\n        </div>\n        <button class=\"btn\" onclick=\"validateDualLogin()\">Enter ✦</button>\n      </div>\n    </div>\n\n    <div id=\"choicePage\" class=\"page\">\n          <div class=\"card\">\n            <h2>Pilih Mode ✦</h2>\n            \n            <div class=\"menu-grid\">\n            <div class=\"menu-box\" onclick=\"showPage('manualPage')\">✜ <span>Manual Control</span></div>\n            <div class=\"menu-box\" onclick=\"renderTemplates(); showPage('templatePage')\">❖ <span>Tangram Template</span></div>\n            <div class=\"menu-box\" onclick=\"renderGameGrid(); showPage('gamePage')\"><span>Game Mode</span></div>\n            <div class=\"menu-box\" onclick=\"showPage('visionPage')\">◎ <span>Live Vision Monitor</span></div>\n            <div class=\"menu-box\" style=\"border-style:dotted; grid-column: span 2;\" onclick=\"logout()\">\n              ⍈ <span>Sign Out</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div id=\"templatePage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Templates</h1>\n        <p>Pilih desain template ✦</p>\n        <div class=\"menu-grid\" id=\"templateGridContainer\"></div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px\">\n          <button class=\"btn\" style=\"background-color:var(--pink-soft);color:white;width:100%;margin:0\" onclick=\"acakFisikDobot()\">↻ Acak Kepingan Fisik</button>\n          <button class=\"btn btn-back\" style=\"width:100%;margin:0\" onclick=\"showPage('choicePage')\">Kembali</button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"gamePage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Tebak Gambar</h1>\n        <p>Pilih kotak misteri dan tebak apa yang digambar Dobot!</p>\n        <div class=\"menu-grid\" id=\"gameGridContainer\"></div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px\">\n          <button class=\"btn\" style=\"background-color:var(--pink-deep);color:white;width:100%;margin:0\" onclick=\"acakFisikDobot()\">↺ Acak Kepingan Fisik</button>\n          <button class=\"btn btn-back\" style=\"width:100%;margin:0\" onclick=\"showPage('choicePage')\">Kembali</button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"manualPage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Manual View</h1>\n        <div class=\"coord-container\">\n          <div class=\"coord-display\">\n            📍 Saat ini: X:<span id=\"currX\">0.0</span> Y:<span id=\"currY\">0.0</span>\n            Z:<span id=\"currZ\">0.0</span> R:<span id=\"currR\">0.0</span>\n          </div>\n          <div class=\"coord-inputs\">\n            <input type=\"number\" id=\"inpX\" placeholder=\"X\" />\n            <input type=\"number\" id=\"inpY\" placeholder=\"Y\" />\n            <input type=\"number\" id=\"inpZ\" placeholder=\"Z\" />\n            <input type=\"number\" id=\"inpR\" placeholder=\"R\" />\n          </div>\n          <button class=\"btn btn-sm\" style=\"margin-top:10px\" onclick=\"sendCoordinate()\">Jalan</button>\n        </div>\n\n        <div class=\"analog-wrapper\">\n          <div style=\"position:relative;margin:10px\">\n            <span style=\"position:absolute;top:-20px;left:50%;transform:translateX(-50%);font-weight:bold;color:var(--pink-deep);font-size:0.9em\">-X</span>\n            <span style=\"position:absolute;bottom:-20px;left:50%;transform:translateX(-50%);font-weight:bold;color:var(--pink-deep);font-size:0.9em\">+X</span>\n            <span style=\"position:absolute;left:-25px;top:50%;transform:translateY(-50%);font-weight:bold;color:var(--pink-deep);font-size:0.9em\">-Y</span>\n            <span style=\"position:absolute;right:-25px;top:50%;transform:translateY(-50%);font-weight:bold;color:var(--pink-deep);font-size:0.9em\">+Y</span>\n            <div class=\"analog-container\">\n              <div></div>\n              <button class=\"btn btn-ctrl\" onmousedown=\"startHold('mundur')\" onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">▲</button>\n              <div></div>\n              <button class=\"btn btn-ctrl\" onmousedown=\"startHold('kanan')\"  onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">◀</button>\n              <div style=\"font-size:1.8em\">✿</div>\n              <button class=\"btn btn-ctrl\" onmousedown=\"startHold('kiri')\"   onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">▶</button>\n              <div></div>\n              <button class=\"btn btn-ctrl\" onmousedown=\"startHold('maju')\"   onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">▼</button>\n              <div></div>\n            </div>\n          </div>\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:10px\">\n            <button class=\"btn btn-ctrl\" onmousedown=\"startHold('atas')\"  onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">⇡</button>\n            <span style=\"font-weight:bold;color:var(--pink-deep);font-size:1.1em\">Z</span>\n            <button class=\"btn btn-ctrl\" onmousedown=\"startHold('bawah')\" onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">⇣</button>\n          </div>\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:10px\">\n            <button class=\"btn btn-ctrl\" onmousedown=\"startHold('rotate_ccw')\" onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">↺</button>\n            <span style=\"font-weight:bold;color:var(--pink-deep);font-size:1.1em\">R</span>\n            <button class=\"btn btn-ctrl\" onmousedown=\"startHold('rotate_cw')\"  onmouseup=\"stopHold()\" onmouseleave=\"stopHold()\">↻</button>\n          </div>\n        </div>\n\n        <div>\n          <button class=\"btn\" style=\"background-color:#ffdab9;color:#cd853f\" onclick=\"sendManualCommand('grab')\">Grab ♡</button>\n          <button class=\"btn\" style=\"background-color:#e0ffff;color:#5f9ea0\" onclick=\"sendManualCommand('release')\">Release ✿</button>\n        </div>\n        <button class=\"btn btn-danger\" onclick=\"sendManualCommand('reset')\">Reset Dobot</button>\n        <button class=\"btn\" style=\"border:2px dashed var(--pink-deep);margin-top:10px;width:100%;background:transparent;color:var(--text-main)\" onclick=\"sendManualCommand('clear_alarm')\">Reset Alarm</button>\n        <button class=\"btn btn-back\" style=\"margin-top:10px;width:100%\" onclick=\"showPage('choicePage')\">Kembali</button>\n      </div>\n    </div>\n\n    <div id=\"engineerChoicePage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Dashboard System</h1>\n        <p style=\"color:#64748b;margin-bottom:30px\">Template Management Configuration</p>\n        <div style=\"display:flex;flex-direction:column;gap:15px\">\n          <button class=\"btn\" style=\"width:100%;padding:20px;font-size:1.1em\" onclick=\"showPage('engineerSimPage')\">+ Tambah Bentuk Template</button>\n          <button class=\"btn btn-back\" style=\"width:100%;padding:20px;font-size:1.1em;border:1px solid var(--eng-border)\" onclick=\"openDeleteModal()\">- Kurangi Bentuk Template</button>\n          <button class=\"btn btn-danger\" style=\"width:100%;padding:20px;margin-top:10px;font-size:1.1em\" onclick=\"logout()\">Sign Out</button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"engineerSimPage\" class=\"page page-wide\">\n      <div class=\"card\" style=\"padding:20px\">\n        <h2 style=\"margin:0 0 5px 0\">Simulation Workspace</h2>\n        <p style=\"color:#64748b;font-size:14px;margin-bottom:20px\">Susun kepingan di ALAS. Drag bebas (Snap 5px otomatis). Klik untuk rotasi 45°.</p>\n\n        <div class=\"sim-workspace\" id=\"simWorkspace\">\n          <div class=\"sim-base\"  id=\"simBaseArea\"></div>\n          <div class=\"sim-tray\"  id=\"simTrayArea\"></div>\n          <div class=\"tangram-piece shape-big-tri-1\"   style=\"right:20px;top:20px\"  data-rot=\"0\"></div>\n          <div class=\"tangram-piece shape-big-tri-2\"   style=\"right:20px;top:80px\"  data-rot=\"0\"></div>\n          <div class=\"tangram-piece shape-med-tri\"     style=\"right:20px;top:140px\" data-rot=\"0\"></div>\n          <div class=\"tangram-piece shape-small-tri-1\" style=\"right:20px;top:200px\" data-rot=\"0\"></div>\n          <div class=\"tangram-piece shape-small-tri-2\" style=\"right:20px;top:260px\" data-rot=\"0\"></div>\n          <div class=\"tangram-piece shape-square\"      style=\"right:20px;top:320px\" data-rot=\"0\"></div>\n          <div class=\"tangram-piece shape-para\"        style=\"right:20px;top:380px\" data-rot=\"0\"></div>\n        </div>\n\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px\">\n          <button class=\"btn\" onclick=\"openNamingModal()\">Submit Shape</button>\n          <button class=\"btn btn-back\" onclick=\"resetSim(); showPage('engineerChoicePage');\">Batal & Kembali</button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"visionPage\" class=\"page\">\n      <!-- Kita gunakan flex container untuk memusatkan card -->\n      <div style=\"display: flex; justify-content: center; align-items: center; min-height: 80vh; width: 100%;\">\n        <div class=\"card\" style=\"width:min(90vw, 1000px); padding: 24px; text-align: center;\">\n          <h2 style=\"margin-bottom:10px;\">Live Vision Monitor</h2>\n          <p style=\"margin:0 0 12px; font-weight:600;\">Laptop CV: <a href=\"http://10.6.101.123:8000/monitor\" target=\"_blank\" rel=\"noreferrer\">full monitor</a></p>\n          \n          <img id=\"visionStream\" src=\"http://10.6.101.123:8000/monitor/stream/overview.mjpg\" alt=\"Tangram vision stream\" style=\"display:block; width:100%; height:auto; max-height:60vh; object-fit:contain; border-radius:18px; background:#111; box-shadow:0 10px 28px rgba(0,0,0,.18); margin: 0 auto;\" />\n          \n          <button class=\"btn btn-back\" style=\"width:100%; margin-top:20px;\" onclick=\"showPage('choicePage')\">Kembali</button>\n        </div>\n      </div>\n    </div>\n\n    <footer class=\"footer-info\" style=\"position:fixed;bottom:15px;z-index:50\">\n      <b>TF4017 - KIT F ୨୧</b>\n    </footer>\n\n    <script src=\"/app.js?v=1.0\"></script>\n  </body>\n</html>\n",

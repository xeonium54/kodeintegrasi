    "id": "10277171f2a8ea18",
    "type": "template",
    "z": "cfe2e652490ea0f7",
    "name": "Smooth",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!doctype html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>୨୧ Coquette Dobot HMI ୨୧</title>\n    <style>\n      @import url(\"https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Quicksand:wght@400;600&display=swap\");\n\n      :root {\n        --pink-soft: #ffc0cb;\n        --pink-deep: #ff69b4;\n        --cream: #fff5f8;\n        --rose: #db7093;\n        --lace: #fff0f5;\n      }\n\n      body {\n        background-color: var(--cream);\n        font-family: \"Quicksand\", sans-serif;\n        color: var(--rose);\n        margin: 0;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        min-height: 100vh;\n        background-image: radial-gradient(\n          var(--pink-soft) 2px,\n          transparent 2px\n        );\n        background-size: 25px 25px;\n        overflow-x: hidden;\n        /* Mencegah highlight teks saat menekan tombol lama */\n        user-select: none;\n        -webkit-user-select: none;\n      }\n\n      /* Navigasi Halaman */\n      .page {\n        display: none;\n        width: 100%;\n        max-width: 550px;\n        padding: 20px;\n        text-align: center;\n      }\n      .active {\n        display: block;\n        animation: softFade 0.6s ease-in-out;\n      }\n\n      @keyframes softFade {\n        from {\n          opacity: 0;\n          transform: scale(0.95);\n        }\n        to {\n          opacity: 1;\n          transform: scale(1);\n        }\n      }\n\n      /* Card Style */\n      .card {\n        background: white;\n        border: 5px solid var(--pink-soft);\n        border-radius: 40px;\n        padding: 40px;\n        box-shadow: 0 15px 35px rgba(255, 182, 193, 0.4);\n        position: relative;\n        outline: 2px dashed white;\n        outline-offset: -12px;\n      }\n\n      .card::before {\n        content: \"୨୧\";\n        position: absolute;\n        top: -25px;\n        left: 50%;\n        transform: translateX(-50%);\n        font-size: 3em;\n        filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.1));\n      }\n\n      h1 {\n        font-family: \"Caveat\", cursive;\n        font-size: 3.5em;\n        color: var(--pink-deep);\n        margin-bottom: 5px;\n      }\n      p {\n        font-style: italic;\n        font-size: 0.95em;\n      }\n\n      /* Input Login */\n      .input-group {\n        margin: 20px 0;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        gap: 10px;\n      }\n      .input-wrapper {\n        position: relative;\n        width: 85%;\n      }\n\n      input {\n        width: 100%;\n        box-sizing: border-box;\n        padding: 15px;\n        border: 2px solid var(--pink-soft);\n        border-radius: 20px;\n        outline: none;\n        text-align: center;\n        font-family: \"Quicksand\", sans-serif;\n        background: var(--lace);\n        transition: 0.3s;\n      }\n      input:focus {\n        border-color: var(--pink-deep);\n        background: white;\n      }\n\n      /* Coordinate Inputs & Display */\n      .coord-container {\n        background: var(--lace);\n        border: 2px dashed var(--pink-soft);\n        border-radius: 20px;\n        padding: 15px;\n        margin: 20px 0;\n      }\n      .coord-display {\n        font-size: 1.1em;\n        font-weight: bold;\n        color: var(--pink-deep);\n        margin-bottom: 15px;\n      }\n      .coord-inputs {\n        display: flex;\n        gap: 8px;\n        justify-content: center;\n      }\n      .coord-inputs input {\n        width: 60px;\n        padding: 10px;\n        font-size: 0.9em;\n        border-radius: 10px;\n      }\n\n      .toggle-eye {\n        position: absolute;\n        right: 15px;\n        top: 50%;\n        transform: translateY(-50%);\n        cursor: pointer;\n        font-size: 1em;\n        font-weight: bold;\n        opacity: 0.7;\n      }\n      .toggle-eye:hover {\n        opacity: 1;\n      }\n\n      /* Buttons */\n      .btn {\n        background-color: var(--pink-soft);\n        color: white;\n        border: none;\n        padding: 15px 35px;\n        border-radius: 30px;\n        font-size: 1.1em;\n        font-weight: 600;\n        cursor: pointer;\n        transition: all 0.3s ease;\n        margin: 10px;\n        box-shadow: 0 5px 15px rgba(255, 192, 203, 0.5);\n      }\n      .btn:hover {\n        background-color: var(--pink-deep);\n        transform: translateY(-3px);\n      }\n      .btn:active {\n        transform: scale(0.95);\n      }\n      .btn-sm {\n        padding: 10px 20px;\n        font-size: 0.9em;\n      }\n      .btn-back {\n        background-color: #e6e6fa;\n        color: #9370db;\n      }\n      .btn-danger {\n        background-color: #ff9999;\n        color: white;\n        margin-top: 15px;\n        width: 100%;\n      }\n\n      /* Menu Selection */\n      .menu-grid {\n        display: grid;\n        gap: 18px;\n        margin-top: 25px;\n      }\n      .menu-box {\n        background: var(--lace);\n        border: 2px solid var(--pink-soft);\n        padding: 25px;\n        border-radius: 25px;\n        cursor: pointer;\n        transition: 0.3s;\n        font-weight: bold;\n        font-size: 1.2em;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 10px;\n      }\n      .menu-box:hover {\n        background: white;\n        border-color: var(--pink-deep);\n        transform: scale(1.02);\n      }\n\n      /* Analog Center Control */\n      .analog-wrapper {\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        gap: 20px;\n        margin: 20px auto;\n        padding: 20px;\n        background: var(--lace);\n        border-radius: 40px;\n        width: max-content;\n      }\n      .analog-container {\n        display: grid;\n        grid-template-columns: 55px 55px 55px;\n        grid-template-rows: 55px 55px 55px;\n        gap: 8px;\n        justify-items: center;\n        align-items: center;\n      }\n      .btn-ctrl {\n        width: 50px;\n        height: 50px;\n        padding: 0;\n        border-radius: 50%;\n        font-size: 1.3em;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        background: white;\n        border: 2px solid var(--pink-soft);\n        color: var(--rose);\n        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.05);\n        cursor: pointer;\n        touch-action: manipulation;\n      }\n      .btn-ctrl:active {\n        transform: scale(0.9);\n        background: var(--pink-deep);\n        color: white;\n      }\n\n      .footer-info {\n        font-size: 0.8em;\n        margin-top: 20px;\n        opacity: 0.7;\n        letter-spacing: 1px;\n      }\n\n      /* CUSTOM POP-UP MODAL STYLE */\n      .modal-overlay {\n        display: none;\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background: rgba(255, 192, 203, 0.4);\n        backdrop-filter: blur(4px);\n        z-index: 2000;\n        justify-content: center;\n        align-items: center;\n      }\n      .modal-box {\n        background: white;\n        border: 4px dashed var(--pink-soft);\n        border-radius: 30px;\n        padding: 30px 40px;\n        text-align: center;\n        box-shadow: 0 15px 35px rgba(255, 105, 180, 0.4);\n        max-width: 80%;\n        width: 350px;\n        animation: popIn 0.5s ease;\n      }\n      .modal-box h2 {\n        font-family: \"Caveat\", cursive;\n        font-size: 3em;\n        color: var(--pink-deep);\n        margin: 0 0 10px 0;\n      }\n    </style>\n  </head>\n  <body>\n    <div id=\"cuteModal\" class=\"modal-overlay\">\n      <div class=\"modal-box\">\n        <h2 id=\"modalTitle\">(╥﹏╥)</h2>\n        <p\n          id=\"modalMessage\"\n          style=\"font-size: 1.1em; font-weight: 600; margin-bottom: 20px\"\n        >\n          Pesan error di sini\n        </p>\n        <button class=\"btn\" onclick=\"closeModal()\">Okee ♡</button>\n      </div>\n    </div>\n\n    <div id=\"loginPage\" class=\"page active\">\n      <div class=\"card\">\n        <h1>Bonjouuuur! ✧</h1>\n        <p>Ready to build something cute? ✦</p>\n        <div class=\"input-group\">\n          <div class=\"input-wrapper\">\n            <input type=\"text\" placeholder=\"Username\" id=\"userInput\" />\n          </div>\n          <div class=\"input-wrapper\">\n            <input type=\"password\" placeholder=\"Password\" id=\"passInput\" />\n            <span class=\"toggle-eye\" id=\"eyeIcon\" onclick=\"togglePassword()\"\n              >O_O</span\n            >\n          </div>\n        </div>\n        <button class=\"btn\" onclick=\"validateLogin()\">Enter ✦</button>\n      </div>\n    </div>\n\n    <div id=\"choicePage\" class=\"page\">\n      <div class=\"card\">\n        <h2>Pilih Mode ✦</h2>\n        <div class=\"menu-grid\">\n          <div class=\"menu-box\" onclick=\"showPage('manualPage')\">\n            ✜ <span>Manual Control</span>\n          </div>\n          <div class=\"menu-box\" onclick=\"showPage('templatePage')\">\n            ❖ <span>Tangram Template</span>\n          </div>\n          <div\n            class=\"menu-box\"\n            style=\"background-color: #fffaf0; border-style: dotted\"\n            onclick=\"logout()\"\n          >\n            ⍈ <span>Sign Out</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"manualPage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Manual View ♛</h1>\n\n        <div class=\"coord-container\">\n          <div class=\"coord-display\">\n            📍 Saat ini: X:<span id=\"currX\">0.0</span> Y:<span id=\"currY\"\n              >0.0</span\n            >\n            Z:<span id=\"currZ\">0.0</span> R:<span id=\"currR\">0.0</span>\n          </div>\n          <p style=\"margin-top: 0; font-size: 0.85em\">\n            Pindah ke Koordinat Tertentu:\n          </p>\n          <div class=\"coord-inputs\">\n            <input type=\"number\" id=\"inpX\" placeholder=\"X\" />\n            <input type=\"number\" id=\"inpY\" placeholder=\"Y\" />\n            <input type=\"number\" id=\"inpZ\" placeholder=\"Z\" />\n            <input type=\"number\" id=\"inpR\" placeholder=\"R\" />\n          </div>\n          <button\n            class=\"btn btn-sm\"\n            style=\"margin-top: 10px\"\n            onclick=\"sendCoordinate()\"\n          >\n            Jalan 🚀\n          </button>\n        </div>\n\n        <div class=\"analog-wrapper\">\n          <div class=\"analog-container\">\n            <div></div>\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('mundur')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('mundur')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ▲\n            </button>\n            <div></div>\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('kanan')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('kanan')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ◀\n            </button>\n            <div style=\"font-size: 1.8em\">✿</div>\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('kiri')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('kiri')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ▶\n            </button>\n            <div></div>\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('maju')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('maju')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ▼\n            </button>\n            <div></div>\n          </div>\n\n          <div\n            style=\"\n              display: flex;\n              flex-direction: column;\n              align-items: center;\n              gap: 10px;\n            \"\n          >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('atas')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('atas')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ⇡\n            </button>\n            <span\n              style=\"\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 1.1em;\n              \"\n              >Z</span\n            >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('bawah')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('bawah')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ⇣\n            </button>\n          </div>\n\n          <div\n            style=\"\n              display: flex;\n              flex-direction: column;\n              align-items: center;\n              gap: 10px;\n            \"\n          >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('rotate_ccw')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('rotate_ccw')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ↺\n            </button>\n            <span\n              style=\"\n                font-weight: bold;\n                color: var(--pink-deep);\n                font-size: 1.1em;\n              \"\n              >R</span\n            >\n            <button\n              class=\"btn btn-ctrl\"\n              onmousedown=\"startHold('rotate_cw')\"\n              onmouseup=\"stopHold()\"\n              onmouseleave=\"stopHold()\"\n              ontouchstart=\"startHold('rotate_cw')\"\n              ontouchend=\"stopHold()\"\n              ontouchcancel=\"stopHold()\"\n            >\n              ↻\n            </button>\n          </div>\n        </div>\n\n        <div>\n          <button\n            class=\"btn\"\n            style=\"background-color: #ffdab9; color: #cd853f\"\n            onclick=\"sendManualCommand('grab')\"\n          >\n            Grab ♡\n          </button>\n          <button\n            class=\"btn\"\n            style=\"background-color: #e0ffff; color: #5f9ea0\"\n            onclick=\"sendManualCommand('release')\"\n          >\n            Release ✿\n          </button>\n        </div>\n\n        <button class=\"btn btn-danger\" onclick=\"sendManualCommand('reset')\">\n          Reset Posisi ↺\n        </button>\n        <button class=\"btn\" style=\"background-color: #ffe4e1; color: #d81b60; border: 2px dashed #ffb6c1; margin-top: 10px; width: 100%;\" onclick=\"sendManualCommand('clear_alarm')\">\n          Reset Dobot\n        </button>\n        <button\n          class=\"btn btn-back\"\n          style=\"margin-top: 10px; width: 100%\"\n          onclick=\"showPage('choicePage')\"\n        >\n          Kembali\n        </button>\n      </div>\n    </div>\n\n    <div id=\"templatePage\" class=\"page\">\n      <div class=\"card\">\n        <h1>Templates</h1>\n        <p>Pilih desain template ✦</p>\n        <div class=\"menu-grid\">\n          <div class=\"menu-box\" onclick=\"runTemplate('Kucing')\">\n            (=^･ω･^=) Kucing\n          </div>\n          <div class=\"menu-box\" onclick=\"runTemplate('Unta')\">/\\_/\\_ Unta</div>\n          <div class=\"menu-box\" onclick=\"runTemplate('Rumah')\">⌂ Rumah</div>\n          <div class=\"menu-box\" onclick=\"runTemplate('Kotak')\">⊞ Kotak</div>\n        </div>\n        <button\n          class=\"btn btn-back\"\n          style=\"margin-top: 20px; width: 100%\"\n          onclick=\"showPage('choicePage')\"\n        >\n          Kembali\n        </button>\n      </div>\n    </div>\n\n    <script>\n      // === STATE KOORDINAT LOKAL ===\n      let currentX = 0.0;\n      let currentY = 0.0;\n      let currentZ = 0.0;\n      let currentR = 0.0;\n\n      // Estimasi pergerakan per 200ms. Sesuaikan nilai ini dengan kecepatan asli mesin\n      const JOG_STEP = 2.0;\n\n      function updateCoordUI() {\n        document.getElementById(\"currX\").innerText = currentX.toFixed(1);\n        document.getElementById(\"currY\").innerText = currentY.toFixed(1);\n        document.getElementById(\"currZ\").innerText = currentZ.toFixed(1);\n        document.getElementById(\"currR\").innerText = currentR.toFixed(1);\n      }\n\n      window.onload = updateCoordUI;\n\n      // --- PASSWORD & MODAL LOGIC ---\n      function togglePassword() {\n        const passInput = document.getElementById(\"passInput\");\n        const eyeIcon = document.getElementById(\"eyeIcon\");\n        if (passInput.type === \"password\") {\n          passInput.type = \"text\";\n          eyeIcon.innerText = \">_<\";\n        } else {\n          passInput.type = \"password\";\n          eyeIcon.innerText = \"O_O\";\n        }\n      }\n\n      function showModal(title, message) {\n        document.getElementById(\"modalTitle\").innerText = title;\n        document.getElementById(\"modalMessage\").innerText = message;\n        document.getElementById(\"cuteModal\").style.display = \"flex\";\n      }\n\n      function closeModal() {\n        document.getElementById(\"cuteModal\").style.display = \"none\";\n      }\n\n      // --- LOGIN & NAVIGATION ---\n      function validateLogin() {\n        const user = document.getElementById(\"userInput\").value;\n        const pass = document.getElementById(\"passInput\").value;\n        if (user === \"user\" && pass === \"123\") {\n          showPage(\"choicePage\");\n        } \n        else {\n          showModal(\n            \"(╥﹏╥)\",\n            \"Salah nih username atau password-nya! Coba dicek lagi yaa ♡\",\n          );\n        }\n      }\n\n      function logout() {\n        document.getElementById(\"userInput\").value = \"\";\n        document.getElementById(\"passInput\").value = \"\";\n        showPage(\"loginPage\");\n      }\n\n      function showPage(pageId) {\n        document\n          .querySelectorAll(\".page\")\n          .forEach((p) => p.classList.remove(\"active\"));\n        document.getElementById(pageId).classList.add(\"active\");\n      }\n\n      // --- FETCH COMMANDS ---\n      function runTemplate(name) {\n        showModal(\n          \"Yay! ✦\",\n          \"Dobot sedang memproses template \" +\n            name +\n            \"... Mohon tunggu sebentar ya!\",\n        );\n        fetch(\"/perintah\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ mode: \"template\", target_bentuk: name }),\n        }).catch((error) => console.error(\"Error:\", error));\n      }\n\n      function sendManualCommand(aksi) {\n        if (aksi === \"reset\") {\n          currentX = 0.0;\n          currentY = 0.0;\n          currentZ = 0.0;\n          currentR = 0.0;\n          updateCoordUI();\n        }\n\n        fetch(\"/perintah\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ mode: \"manual\", action: aksi }),\n        }).catch((error) => console.error(\"Error:\", error));\n      }\n\n      // --- FITUR KIRIM KOORDINAT KETIK ---\n      function sendCoordinate() {\n        const x = document.getElementById(\"inpX\").value;\n        const y = document.getElementById(\"inpY\").value;\n        const z = document.getElementById(\"inpZ\").value;\n        const r = document.getElementById(\"inpR\").value;\n\n        if (!x || !y || !z || !r) {\n          showModal(\"(╥﹏╥)\", \"Isi semua angka koordinatnya dulu yaa ♡\");\n          return;\n        }\n\n        currentX = parseFloat(x);\n        currentY = parseFloat(y);\n        currentZ = parseFloat(z);\n        currentR = parseFloat(r);\n        updateCoordUI();\n\n        const dataPerintah = {\n          mode: \"koordinat\",\n          target: { x: currentX, y: currentY, z: currentZ, r: currentR },\n        };\n\n        fetch(\"/perintah\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify(dataPerintah),\n        }).catch((error) => console.error(\"Error:\", error));\n\n        document.getElementById(\"inpX\").value = \"\";\n        document.getElementById(\"inpY\").value = \"\";\n        document.getElementById(\"inpZ\").value = \"\";\n        document.getElementById(\"inpR\").value = \"\";\n      }\n\n      // --- LOGIC HOLD TOMBOL ANALOG & UPDATE KOORDINAT ---\n      let holdInterval = null;\n\n      function applyJogDirection(aksi) {\n        switch (aksi) {\n          case \"maju\":\n            currentX += JOG_STEP;\n            break;\n          case \"mundur\":\n            currentX -= JOG_STEP;\n            break;\n          case \"kiri\":\n            currentY += JOG_STEP;\n            break;\n          case \"kanan\":\n            currentY -= JOG_STEP;\n            break;\n          case \"atas\":\n            currentZ += JOG_STEP;\n            break;\n          case \"bawah\":\n            currentZ -= JOG_STEP;\n            break;\n          case \"rotate_cw\":\n            currentR -= JOG_STEP;\n            break;\n          case \"rotate_ccw\":\n            currentR += JOG_STEP;\n            break;\n        }\n        updateCoordUI();\n      }\n\n      // variabel holdInterval dan fungsi applyJogDirection boleh kamu hapus sekalian\n\n      function startHold(aksi) {\n        sendManualCommand(aksi);\n      }\n\n      function stopHold() {\n        sendManualCommand(\"stop\");\n      }\n\n      function stopHold() {\n        if (holdInterval) {\n          clearInterval(holdInterval);\n          holdInterval = null;\n          sendManualCommand(\"stop\");\n        }\n      }\n    </script>\n\n    <footer class=\"footer-info\" style=\"position: fixed; bottom: 15px\">\n      <b>TF4017 - KIT F ୨୧</b>\n    </footer>\n  </body>\n</html>",
